rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Pillar 2: Validation Blueprint
    function isValidUser(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.totalScore is number && data.totalScore >= 0 &&
             data.highScore is number && data.highScore >= 0 &&
             (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             (data.avatarSeed == null || (data.avatarSeed is string && data.avatarSeed.size() <= 128)) &&
             data.progress is map &&
             data.progress.beginner is number &&
             data.progress.medium is number &&
             data.progress.advance is number &&
             // Ensure strict keys on creation to prevent Ghost Fields
             data.keys().hasAll(['userId', 'displayName', 'totalScore', 'highScore', 'progress']) &&
             // Limit total size to prevent Denial of Wallet
             data.keys().size() <= 15;
    }

    match /users/{userId} {
      // Allow read for everyone (even guests) to see the Global Leaderboard
      // Pillar 8: Secure List Queries
      allow read: if true; 

      allow create: if isOwner(userId) && 
                      isValidId(userId) && 
                      isValidUser(incoming()) &&
                      incoming().userId == request.auth.uid;

      allow update: if isOwner(userId) && 
                      isValidId(userId) && 
                      isValidUser(incoming()) &&
                      incoming().userId == existing().userId &&
                      (
                        // Pillar 4 & 9: Action-Based Update / Immortality
                        incoming().diff(existing()).affectedKeys().hasOnly(['totalScore', 'highScore', 'progress', 'gameHistory', 'unlockedAchievements', 'categoryStats', 'lastPlayed', 'settings', 'avatarSeed', 'displayName', 'photoURL'])
                      );
    }
  }
}
